# ---------- Server ----------
PORT=5000
FRONTEND_URL=http://localhost:3000

# ---------- Supabase ----------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_AVATAR_BUCKET=avatars

# ---------- Auth ----------
GOOGLE_CLIENT_ID=
JWT_SECRET=
# Admin Panel password. SET YOUR OWN - if this is empty the backend falls back to
# the old built-in password from the README, which is public if the repo is public.
ADMIN_PASSWORD=

# ---------- Web Push (optional) ----------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ---------- Paywall / Billing ----------
# Master switch. false = every desk is free for everyone (nothing is
# enforced). Turn it to true only AFTER the Razorpay keys below are filled.
PAYWALL_ENABLED=false
# Free trial for each user, in days, counted from signup. 0 = no trial.
TRIAL_DAYS=1
# Price of one subscription period, in rupees. Change anytime (restart the server).
SUBSCRIPTION_PRICE_INR=149
# How many days one payment unlocks the WHOLE website (all desks).
SUBSCRIPTION_DAYS=30

# Razorpay -> Dashboard -> Account & Settings -> API Keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay -> Settings -> Webhooks -> add  https://<your-backend>/api/billing/webhook
# with event "payment.captured" and paste the secret you chose here.
# (Backup only - payments are also confirmed instantly from the browser.)
RAZORPAY_WEBHOOK_SECRET=

# ---------- Analytics ----------
# Daily/hourly counts are bucketed in this timezone. 330 = India (IST, UTC+5:30).
ANALYTICS_TZ_OFFSET_MINUTES=330
# A person with 0 visits in this many days is flagged "inactive".
INACTIVE_DAYS=30
